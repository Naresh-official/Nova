{
	"extends": "@nova/typescript-config/react-library.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@nova/ui/*": ["./src/*"]
		},
		"lib": ["dom", "dom.iterable", "esnext"],
		"composite": true,
		"noEmit": false,
		"emitDeclarationOnly": true,
		"allowImportingTsExtensions": true
	},
	"include": ["."],
	"exclude": ["node_modules", "dist"]
}
