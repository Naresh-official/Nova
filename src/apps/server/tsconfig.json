{
	"extends": "@nova/typescript-config/base.json",
	"include": ["src"],
	"exclude": ["node_modules", "generated"],
	"compilerOptions": {
		"plugins": [
			{
				"name": "@effect/language-service"
			}
		],
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": ".",
		"paths": {
			"@server/*": ["src/*"]
		},
		"composite": true,
		"noEmit": false,
		"emitDeclarationOnly": true
	}
}
