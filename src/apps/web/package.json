{
	"name": "@nova/web",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"build:no-lint": "SKIP_ENV_VALIDATION=true next build",
		"start": "next start",
		"lint": "next lint",
		"lint:fix": "next lint --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nova/ui": "workspace:*",
		"@tanstack/react-query": "^5.83.0",
		"@tanstack/react-query-devtools": "^5.84.0",
		"@tiptap/extension-image": "^3.0.9",
		"@tiptap/react": "^3.0.9",
		"@tiptap/starter-kit": "^3.0.9",
		"@trpc/client": "^11.4.3",
		"@trpc/next": "^11.4.3",
		"@trpc/react-query": "^11.4.3",
		"@trpc/tanstack-react-query": "^11.4.3",
		"axios": "^1.10.0",
		"cheerio": "^1.1.2",
		"date-fns": "^4.1.0",
		"dotenv": "^17.0.1",
		"framer-motion": "^12.23.0",
		"gmail-api-parse-message-ts": "^2.2.33",
		"lucide-react": "^0.525.0",
		"next": "^15.3.4",
		"next-auth": "^4.24.11",
		"next-themes": "^0.4.6",
		"postcss": "8.5.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sanitize-html": "^2.17.0",
		"sonner": "^2.0.7",
		"zod": "^3.24.2",
		"zustand": "^5.0.7"
	},
	"devDependencies": {
		"@nova/eslint-config": "workspace:^",
		"@nova/typescript-config": "workspace:*",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/sanitize-html": "^2.16.0",
		"tailwind-scrollbar": "^4.0.2",
		"typescript": "^5.8.3"
	},
	"turbo": {
		"outputs": [
			".next/**",
			"!.next/cache/**"
		],
		"env": [
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"BACKEND_URL",
			"NEXTAUTH_SECRET",
			"NODE_ENV"
		]
	},
	"packageManager": "pnpm@10.13.1"
}
