{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
		},
		"web#build": {
			"dependsOn": ["^build"],
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"FRONTEND_URL",
				"BACKEND_URL",
				"NEXT_PUBLIC_BACKEND_URL"
			],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				".next/standalone/**",
				".next/static/**"
			]
		},
		"server#build": {
			"dependsOn": ["^build"],
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"FRONTEND_URL",
				"DATABASE_URL",
				"PORT",
				"NODE_ENV"
			],
			"outputs": ["dist/**", "build/**"]
		},
		"web#dev": {
			"cache": false,
			"persistent": true,
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"FRONTEND_URL",
				"BACKEND_URL",
				"NEXT_PUBLIC_BACKEND_URL"
			]
		},
		"server#dev": {
			"cache": false,
			"persistent": true,
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"FRONTEND_URL",
				"DATABASE_URL",
				"PORT",
				"NODE_ENV"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
		}
	}
}
