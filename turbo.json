{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"],
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"BACKEND_URL",
				"NEXTAUTH_SECRET",
				"NODE_ENV"
			]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"BACKEND_URL",
				"NEXTAUTH_SECRET",
				"NODE_ENV"
			]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"BACKEND_URL",
				"NEXTAUTH_SECRET",
				"NODE_ENV"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": [
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"BACKEND_URL",
				"NEXTAUTH_SECRET",
				"NODE_ENV"
			]
		}
	}
}
