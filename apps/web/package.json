{
	"name": "@nova/web",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"build:no-lint": "SKIP_ENV_VALIDATION=true next build",
		"start": "next start",
		"lint": "next lint",
		"lint:fix": "next lint --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nova/ui": "workspace:*",
		"@tanstack/react-query": "^5.100.5",
		"@tanstack/react-query-devtools": "^5.100.5",
		"@tiptap/extension-heading": "^3.22.4",
		"@tiptap/extension-image": "^3.22.4",
		"@tiptap/react": "^3.22.4",
		"@tiptap/starter-kit": "^3.22.4",
		"@trpc/client": "^11.16.0",
		"@trpc/next": "^11.16.0",
		"@trpc/react-query": "^11.16.0",
		"@trpc/tanstack-react-query": "^11.16.0",
		"axios": "^1.15.2",
		"cheerio": "^1.2.0",
		"date-fns": "^4.1.0",
		"dotenv": "^17.4.2",
		"framer-motion": "^12.38.0",
		"gmail-api-parse-message-ts": "^2.2.33",
		"lucide-react": "^1.11.0",
		"next": "^16.2.4",
		"next-auth": "^4.24.14",
		"next-themes": "^0.4.6",
		"postcss": "8.5.12",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-markdown": "^10.1.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"sanitize-html": "^2.17.3",
		"sonner": "^2.0.7",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@nova/eslint-config": "workspace:^",
		"@nova/typescript-config": "workspace:*",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/sanitize-html": "^2.16.1",
		"tailwind-scrollbar": "^4.0.2",
		"typescript": "^6.0.3"
	},
	"turbo": {
		"outputs": [
			".next/**",
			"!.next/cache/**"
		],
		"env": [
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"BACKEND_URL",
			"NEXTAUTH_SECRET",
			"NODE_ENV"
		]
	},
	"packageManager": "pnpm@10.15.0"
}
