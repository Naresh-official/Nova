{
	"extends": "@nova/typescript-config/base.json",
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "generated"],
	"references": [
		{ "path": "../../packages/ai" },
		{ "path": "../../packages/mail" },
		{ "path": "../server" }
	],
	"compilerOptions": {
		"plugins": [
			{
				"name": "@effect/language-service"
			}
		],
		"outDir": "./dist",
		"rootDir": "src",
		"baseUrl": ".",
		"paths": {
			"@agent/*": ["src/*"],
			"@server/*": ["../server/src/*"],
			"@nova/mail": ["../../packages/mail/src/index.ts"],
			"@nova/mail/*": ["../../packages/mail/src/*"],
			"@nova/ai": ["../../packages/ai/src/index.ts"],
			"@nova/ai/*": ["../../packages/ai/src/*"]
		},
		"composite": true,
		"noEmit": false,
		"emitDeclarationOnly": true
	}
}
