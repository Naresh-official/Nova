{
	"name": "@nova/mail",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"type-check": "tsc --noEmit",
		"build": "tsup --tsconfig tsconfig.build.json",
		"dev": "tsup --watch"
	},
	"dependencies": {
		"@googleapis/gmail": "^14.0.1",
		"@jrmdayn/googleapis-batcher": "^0.8.0",
		"@react-email/components": "0.5.0",
		"@react-email/render": "1.2.0",
		"base64url": "^3.0.1",
		"google-auth-library": "^10.1.0",
		"mimetext": "^3.0.27",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"sanitize-html": "^2.17.0",
		"uuid": "^11.1.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@nova/eslint-config": "workspace:*",
		"@nova/typescript-config": "workspace:*",
		"@types/node": "^20",
		"typescript": "^5.7.3",
		"tsup": "^8.0.1"
	},
	"packageManager": "pnpm@10.15.0",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	}
}
