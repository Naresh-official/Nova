{
	"name": "@nova/mail",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"type-check": "tsc --noEmit",
		"build": "tsup --tsconfig tsconfig.build.json",
		"dev": "tsup --watch"
	},
	"dependencies": {
		"@googleapis/gmail": "^16.1.1",
		"@jrmdayn/googleapis-batcher": "^0.10.1",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.0.7",
		"base64url": "^3.0.1",
		"google-auth-library": "^10.6.2",
		"mimetext": "^3.0.28",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"sanitize-html": "^2.17.3",
		"uuid": "^14.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@nova/eslint-config": "workspace:*",
		"@nova/typescript-config": "workspace:*",
		"@types/node": "^25.6.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@10.15.0",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	}
}
