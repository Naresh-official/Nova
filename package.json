{
	"name": "nova",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\""
	},
	"devDependencies": {
		"@nova/eslint-config": "workspace:*",
		"@nova/typescript-config": "workspace:*",
		"@types/node": "^24.0.10",
		"prettier": "^3.5.1",
		"turbo": "^2.4.2",
		"typescript": "5.7.3"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=20"
	}
}
