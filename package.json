{
	"name": "nova",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\"",
		"build:web": "pnpm --filter @nova/web run build",
		"build:server": "pnpm turbo run build --filter @nova/server",
		"start:web": "pnpm --filter @nova/web run start",
		"start:server": "pnpm --filter @nova/server run start"
	},
	"devDependencies": {
		"@nova/eslint-config": "workspace:*",
		"@nova/typescript-config": "workspace:*",
		"@types/node": "^25.6.0",
		"prettier": "^3.8.3",
		"tsup": "^8.5.1",
		"turbo": "^2.9.6",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@10.18.2",
	"engines": {
		"node": ">=20"
	}
}
